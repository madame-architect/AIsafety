@misc{guan_deliberativealignment_2024,
    abstract = {As large-scale language models increasingly impact safety-critical domains, ensuring their reliable
                adherence to well-defined principles remains a fundamental challenge. We introduce Deliberative Alignment, a
                new paradigm that directly teaches the model safety specifications and trains it to explicitly recall and
                accurately reason over the specifications before answering. We used this approach to align OpenAI’s o-series
                models [1], and achieved highly precise adherence to OpenAI’s safety policies, without requiring
                human-written chain-of-thoughts or answers. Deliberative Alignment pushes the Pareto frontier by
                simultaneously increasing robustness to jailbreaks while decreasing overrefusal rates, and also improves
                out-of-distribution generalization. We demonstrate that reasoning over explicitly specified policies enables
                more scalable, trustworthy, and interpretable alignment.},
    annotation = {Use for research writing on frontier AI governance and evaluations. Maps 'Deliberative alignment: Reasoning enables safer language models' to paper source; risk domains: cyber; lifecycle: post training, deployment; assurance functions: auditing, mitigation; threat vectors: adaptive attacker.},
