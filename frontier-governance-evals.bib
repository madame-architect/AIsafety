@misc{benton_sabotageevaluations_2024,
    abstract = {Sufficiently capable models could subvert human oversight and decision-making in important contexts. For
                example, in the context of AI development, models could covertly sabotage efforts to evaluate their own
                dangerous capabilities, to monitor their behavior, or to make decisions about their deployment. We refer to
                this family of abilities as sabotage capabilities. We develop a set of related threat models and
                evaluations. These evaluations are designed to provide evidence that a given model, operating under a given
                set of mitigations, could not successfully sabotage a frontier model developer or other large organization's
                activities in any of these ways. We demonstrate these evaluations on Anthropic's Claude 3 Opus and Claude
                3.5 Sonnet models.},
